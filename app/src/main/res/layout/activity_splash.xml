<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/imgSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.96"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash_laundry" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12FFFFFF" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="82dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/neatify_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_splash_text_box"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="Laundry bersih, wangi,\ndan rapi tanpa repot."
            android:textAlignment="center"
            android:textColor="@color/blue_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/blue_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Aplikasi Masa Kini untuk Indonesia"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>